{
  "name": "@funtools/native-ui",
  "version": "2.1.16",
  "description": "UI component library for React Native",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev:yalc": "chokidar \"src/**/*\" --debounce 2400 -c \"npm run build && yalc push\" --polling",
    "dev:npm": "chokidar \"src/**/*\" -c \"npm run build && npm link\" --polling",
    "lint": "eslint src --ext .ts,.tsx",
    "storybook": "mkdir -p .storybook_home/.storybook && HOME=$(pwd)/.storybook_home STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "mkdir -p .storybook_home/.storybook && HOME=$(pwd)/.storybook_home STORYBOOK_DISABLE_TELEMETRY=1 CI=true storybook build"
  },
  "peerDependencies": {
    "@funtools/store": ">=2.0.0 <3.0.0",
    "lucide-react-native": ">=0.300.0",
    "react": ">=18.2.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=4.5.0"
  },
  "devDependencies": {
    "@funtools/store": ">=2.0.0 <3.0.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "@types/react-native": "^0.72.0",
    "babel-plugin-react-native-web": "^0.21.2",
    "chokidar-cli": "^3.0.0",
    "lucide-react": "^1.28.0",
    "lucide-react-native": ">=0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-safe-area-context": "^4.5.0",
    "react-native-web": "^0.19.13",
    "storybook": "^8.6.14",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.0"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "funtools",
    "native",
    "ui-library",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mustak24/funtools-native-ui"
  }
}
